{
  "name": "dashmet-operations-intelligence",
  "version": "1.0.0",
  "description": "Enterprise operations intelligence platform for food safety, manufacturing, and team execution",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:https": "concurrently \"npm run dev:backend\" \"npm run dev:frontend:https\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:frontend:https": "cd frontend && npm run dev:https",
    "build": "echo build",
    "start": "echo start",
    "test": "echo test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
