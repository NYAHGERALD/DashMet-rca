# Frontend Environment Variables for Render.com Production
# Copy these to your Render service environment variables

NODE_ENV=production

# Backend API URL - Update with your actual backend URL after deployment
NEXT_PUBLIC_API_URL=https://dashmet-api.onrender.com/api

# WebSocket URL - Same as API URL but without /api suffix
# Socket.IO handles the protocol upgrade automatically (https -> wss)
NEXT_PUBLIC_WS_URL=https://dashmet-api.onrender.com

# Session warning policy (milliseconds, UI countdown only)
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MS=3600000
NEXT_PUBLIC_SYSTEM_ADMIN_IDLE_TIMEOUT_MS=900000
NEXT_PUBLIC_SESSION_WARNING_WINDOW_MS=300000
NEXT_PUBLIC_SYSTEM_ADMIN_WARNING_WINDOW_MS=120000

# Firebase Configuration (client-side - these are public)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
