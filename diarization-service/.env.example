# Dashmet Diarization Service — Environment
# Copy to .env and fill in values

# Hugging Face token (required for Pyannote model access)
# Get from: https://huggingface.co/settings/tokens
# Accept license at: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# Whisper model size: tiny | base | small | medium | large-v3
# Larger = more accurate but slower / more RAM
# Recommended: "small" for balanced quality/speed, "medium" for production
WHISPER_MODEL_SIZE=base

# Service port
DIARIZATION_PORT=8100

# Pre-load models on startup (true/false)
# Set to true in production to avoid cold-start latency
PRELOAD_MODELS=false

# ── Enterprise Accuracy Tuning ──────────────────────────

# Clustering threshold: controls speaker discrimination sensitivity
# Range: 0.3 (aggressive splitting) to 0.95 (aggressive merging)
# Lower = more speakers detected (splits similar voices)
# Higher = fewer speakers detected (merges similar voices)
# Default: 0.65 (balanced for most meetings)
# Tip: Use 0.5-0.6 for large meetings (5+ people), 0.7-0.8 for 2-person calls
CLUSTERING_THRESHOLD=0.65

# Minimum segment duration (seconds)
# Segments shorter than this are treated as noise and removed
# Default: 0.3 (removes clicks, coughs, mic artifacts)
MIN_SEGMENT_DURATION=0.3

# Same-speaker merge gap (seconds)
# Adjacent segments from the same speaker are merged if the gap
# between them is smaller than this value (prevents over-fragmentation)
# Default: 0.5
SAME_SPEAKER_MERGE_GAP=0.5

# Minimum words per speaker block for smoothing
# Blocks with fewer words than this, sandwiched between same-speaker blocks,
# are absorbed as misattributions (removes single-word speaker flickers)
# Default: 2
MIN_BLOCK_WORDS=2
