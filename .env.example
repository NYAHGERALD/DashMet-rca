# Backend API Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
# WebSocket URL (optional, defaults to API_URL without /api suffix)
# For production: NEXT_PUBLIC_WS_URL=https://api.dashmet.com
NEXT_PUBLIC_WS_URL=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rca_engine

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRE=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@dashmet-rca.com

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-in-production
SESSION_TIMEOUT=3600000

# Multi-Region Support
DEFAULT_REGION=USA
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr
SUPPORTED_REGIONS=USA,Mexico,Canada

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# Azure/AWS Storage (for production)
AZURE_STORAGE_CONNECTION_STRING=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
