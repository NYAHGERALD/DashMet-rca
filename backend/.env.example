NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/rca_engine
# IMPORTANT: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-64-char-hex-key-using-crypto-randomBytes-32
JWT_REFRESH_SECRET=generate-a-DIFFERENT-64-char-hex-key
JWT_EXPIRE=7d
# Session policy (milliseconds)
# SESSION_IDLE_TIMEOUT_MS applies to all non-system-admin users.
SESSION_IDLE_TIMEOUT_MS=3600000
# SYSTEM_ADMIN idle timeout should be stricter.
SYSTEM_ADMIN_IDLE_TIMEOUT_MS=900000
# Absolute lifetime: session must be re-authenticated after this duration
# even with continuous activity.
SESSION_ABSOLUTE_TIMEOUT_MS=86400000
SYSTEM_ADMIN_ABSOLUTE_TIMEOUT_MS=43200000
CORS_ORIGIN=http://localhost:3000
# System Admin Configuration
# IMPORTANT: Keep these values secure and never commit to version control
SYSTEM_ADMIN_EMAIL=nyah.gerard@gmail.com
SYSTEM_ADMIN_EMAIL_ALLOWLIST=nyah.gerard@gmail.com
SYSTEM_ADMIN_EMAIL_ALLOWLIST_ENFORCE=true
# System Admin lockout controls (database-backed, shared across instances)
SYSTEM_ADMIN_LOCKOUT_THRESHOLD=5
SYSTEM_ADMIN_LOCKOUT_DURATION_MINUTES=15
SYSTEM_ADMIN_LOCKOUT_ESCALATION_THRESHOLD=10
SYSTEM_ADMIN_LOCKOUT_ESCALATION_DURATION_MINUTES=60
# System Admin distributed rate limiting controls
SYSTEM_ADMIN_RATE_LIMIT_WINDOW_MINUTES=15
SYSTEM_ADMIN_IP_FAILURE_LIMIT=20
SYSTEM_ADMIN_EMAIL_FAILURE_LIMIT=8
# Limit MFA challenge sends to reduce OTP spamming
SYSTEM_ADMIN_MFA_CHALLENGE_WINDOW_MINUTES=15
SYSTEM_ADMIN_MFA_CHALLENGE_MAX=3
# SYSTEM_ADMIN_MFA_MODE options: email_otp | totp_or_email | totp_only
SYSTEM_ADMIN_MFA_MODE=totp_or_email
# Organization login MFA posture
# ORG_LOGIN_MFA_SCOPE options: off | admin_only | all_users
ORG_LOGIN_MFA_SCOPE=all_users
ORG_LOGIN_MFA_CODE_TTL_MS=600000
ORG_LOGIN_MFA_CHALLENGE_WINDOW_MINUTES=15
ORG_LOGIN_MFA_CHALLENGE_MAX=3
ORG_LOGIN_MFA_MAX_ATTEMPTS=5
# Issuer label shown in authenticator apps
SYSTEM_ADMIN_TOTP_ISSUER=DASHMET Control Center
# Allowed +/- time-step drift for TOTP validation
SYSTEM_ADMIN_TOTP_WINDOW=1
# Optional one-time bootstrap password for seed-system-admin.ts
# SYSTEM_ADMIN_BOOTSTRAP_PASSWORD=Set-Only-For-Bootstrap-Then-Remove
# Firebase Web API Key — required for server-side password reset (oobCode verification)
# This is the same value as NEXT_PUBLIC_FIREBASE_API_KEY from the frontend
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Twilio SMS API (https://www.twilio.com — get credentials from the console)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+14155551234
