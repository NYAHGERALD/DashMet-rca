NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/rca_engine
# IMPORTANT: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-64-char-hex-key-using-crypto-randomBytes-32
JWT_REFRESH_SECRET=generate-a-DIFFERENT-64-char-hex-key
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:3000
# System Admin Configuration
# IMPORTANT: Keep these values secure and never commit to version control
SYSTEM_ADMIN_EMAIL=nyah.gerard@gmail.com
SYSTEM_ADMIN_MASTER_KEY=generate-a-secure-64-character-hex-key-using-crypto-randomBytes-32
# Firebase Web API Key — required for server-side password reset (oobCode verification)
# This is the same value as NEXT_PUBLIC_FIREBASE_API_KEY from the frontend
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
