// Workplace Safety Assessment Models
model WorkplaceSafetyAssessment {
  id                         String                         @id @default(uuid())
  assessmentNumber           String                         @unique
  version                    String                         @default("3/19/25")
  date                       DateTime
  department                 String?
  departmentId               String?
  teamLeaderName             String
  teamLeaderSignature        String?                        // Firebase URL for signature image
  employeeName               String?
  employeeSignature          String?                        // Firebase URL for signature image
  operationManagerName       String?
  operationManagerSignature  String?                        // Firebase URL for signature image
  plantManagerName           String?
  plantManagerSignature      String?                        // Firebase URL for signature image
  safetyManagerName          String?
  safetyManagerSignature     String?                        // Firebase URL for signature image
  status                     WSAStatus                      @default(DRAFT)
  organizationId             String
  facilityId                 String?
  createdById                String
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  submittedAt                DateTime?
  completedAt                DateTime?
  
  // Relations
  Department                 Department?                    @relation(fields: [departmentId], references: [id])
  Facility                   Facility?                      @relation(fields: [facilityId], references: [id])
  Organization               Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  CreatedBy                  User                           @relation(fields: [createdById], references: [id])
  Sections                   WSASection[]
  Photos                     WSAPhoto[]
  WorkOrders                 WorkOrder[]

  @@index([assessmentNumber])
  @@index([createdById])
  @@index([departmentId])
  @@index([facilityId])
  @@index([organizationId])
  @@index([status])
}

model WSASection {
  id           String                    @id @default(uuid())
  assessmentId String
  sectionId    String                    // e.g., 'ppe', 'lockout', 'machine-guarding'
  title        String
  sortOrder    Int                       @default(0)
  
  Assessment   WorkplaceSafetyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  Items        WSAItem[]

  @@index([assessmentId])
  @@unique([assessmentId, sectionId])
}

model WSAItem {
  id                     String      @id @default(uuid())
  sectionId              String
  itemId                 String      // e.g., 'ppe-1', 'lockout-2'
  description            String
  status                 String?     // 'A' (Acceptable), 'U' (Unacceptable), 'NA' (Not Applicable)
  deficiency             String?
  correctiveAction       String?
  dynamicEntries         Json?       // For items with dynamic entries (employee/equipment lists)
  workOrderPlaced        Boolean?    @default(false)
  reportedViaSafetyApp   Boolean?    @default(false)
  safetyAppReportDate    DateTime?
  workOrderDateCreated   DateTime?
  workOrderAssignedTo    String?
  workOrderAttachment    Json?       // { id, name, fileUrl }
  sortOrder              Int         @default(0)
  
  Section                WSASection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@unique([sectionId, itemId])
}

model WSAPhoto {
  id           String                    @id @default(uuid())
  assessmentId String
  itemId       String?                   // Optional: link to specific item
  sectionId    String?                   // Optional: link to specific section
  fileName     String
  fileUrl      String                    // Firebase Storage URL
  fileSize     Int?
  mimeType     String?
  caption      String?
  uploadedAt   DateTime                  @default(now())
  
  Assessment   WorkplaceSafetyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([itemId])
}

// Work Order Settings - Admin controls for work order behavior
model WorkOrderSettings {
  id                    String   @id @default(uuid())
  organizationId        String   @unique
  enableInAppForm       Boolean  @default(true)   // Show in-app work order creation form
  enableTemplateDownload Boolean @default(false)  // Show template download option
  preferredOption       String   @default("form") // "form", "template", or "both"
  formTitle             String   @default("Maintenance Work Order Request")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  Organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Work Order - Tracks all work orders (in-app and uploaded)
model WorkOrder {
  id                     String                     @id @default(uuid())
  woNumber               String                     @unique  // Auto-generated: WO-2026-0001
  type                   WorkOrderType              // IN_APP or UPLOADED
  
  // Link to Safety Assessment
  assessmentId           String
  assessmentNumber       String                     // Denormalized for display
  sectionId              String?
  itemId                 String?
  itemDescription        String?
  
  // Form fields (for in-app work orders)
  requestDate            DateTime?
  expenseClass           String?                    // Fabrication, Safety, Ergonomics, Equipment, USDA, QA, Other
  originator             String?                    // Requestor name
  woType                 String?                    // Repair, Modify, PMD
  priority               Int?                       // 1=Emergency, 2=Rush, 3=Plan & Schedule
  description            String?                    // Nature of problem
  equipmentNo            String?                    // Equipment number (DM#)
  equipmentDescription   String?                    // Equipment name or area
  fullDescriptionOfIssue String?                    @db.Text
  department             String?
  
  // For uploaded files
  fileName               String?
  fileUrl                String?                    // Firebase Storage URL
  fileSize               Int?
  uploadedAt             DateTime?
  
  // Assignment
  assignedTo             String?                    // Free text or user name
  assignedById           String?
  
  // Status
  status                 WorkOrderStatus            @default(PENDING)
  completionDate         DateTime?
  
  // Audit
  createdById            String
  organizationId         String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  
  // Relations
  Assessment             WorkplaceSafetyAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  AssignedBy             User?                      @relation("WorkOrderAssignedBy", fields: [assignedById], references: [id])
  CreatedBy              User                       @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  Organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  StatusHistory          WorkOrderStatusHistory[]

  @@index([assessmentId])
  @@index([assessmentNumber])
  @@index([createdById])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([woNumber])
}

// Work Order Status History - Audit trail for status changes
model WorkOrderStatusHistory {
  id            String          @id @default(uuid())
  workOrderId   String
  fromStatus    WorkOrderStatus?
  toStatus      WorkOrderStatus
  changedById   String
  changedAt     DateTime        @default(now())
  notes         String?
  
  WorkOrder     WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  ChangedBy     User            @relation("WorkOrderStatusChangedBy", fields: [changedById], references: [id])

  @@index([workOrderId])
  @@index([changedById])
  @@index([changedAt])
}

// Work Order Template - Admin uploaded templates for users to download
model WorkOrderTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String                    // Display name for the template
  fileName       String                    // Original file name
  fileUrl        String                    // Firebase Storage URL
  fileSize       Int?
  mimeType       String?                   // application/vnd.openxmlformats-officedocument.wordprocessingml.document, etc.
  description    String?                   // Instructions or description
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  uploadedById   String
  uploadedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  UploadedBy     User         @relation(fields: [uploadedById], references: [id])

  @@unique([organizationId, isActive])     // Only one active template per org
  @@index([organizationId])
  @@index([isActive])
}

model FiveWhysAnalysis {
  id             String         @id @default(cuid())
  rcaAnalysisId  String
  causeId        String         @unique
  causeText      String
  categoryId     String
  categoryName   String
  rootCause      String?
  isComplete     Boolean        @default(false)
  isValidated    Boolean        @default(false)
  recommendation String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  analysisMethod String?
  createdBy      User?          @relation("FiveWhysAnalysisCreatedBy", fields: [createdById], references: [id])
  rcaAnalysis    RCAAnalysis    @relation(fields: [rcaAnalysisId], references: [id], onDelete: Cascade)
  steps          FiveWhysStep[]

  @@index([rcaAnalysisId])
  @@index([causeId])
}

model FiveWhysStep {
  id           String           @id @default(cuid())
  analysisId   String
  stepNumber   Int
  question     String
  answer       String?
  answeredAt   DateTime?
  answeredById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  analysis     FiveWhysAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  answeredBy   User?            @relation("FiveWhysStepAnsweredBy", fields: [answeredById], references: [id])

  @@unique([analysisId, stepNumber])
  @@index([analysisId])
}

model EvidenceSpotlight {
  id             String               @id @default(cuid())
  incidentId     String
  evidenceId     String?
  roomName       String
  presentedById  String
  presentedAt    DateTime             @default(now())
  endedAt        DateTime?
  duration       Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  fmirEvidenceId String?
  annotations    EvidenceAnnotation[]
  evidence       Evidence?            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  incident       Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  presentedBy    User                 @relation("SpotlightPresentedBy", fields: [presentedById], references: [id])

  @@index([incidentId])
  @@index([roomName])
  @@index([evidenceId])
  @@index([fmirEvidenceId])
}

model EvidenceAnnotation {
  id             String            @id @default(cuid())
  spotlightId    String
  userId         String
  annotationType String
  data           Json
  color          String            @default("#FF0000")
  strokeWidth    Int               @default(2)
  createdAt      DateTime          @default(now())
  spotlight      EvidenceSpotlight @relation(fields: [spotlightId], references: [id], onDelete: Cascade)
  user           User              @relation("AnnotationCreatedBy", fields: [userId], references: [id])

  @@index([spotlightId])
}

model DiscussionMarker {
  id          String    @id @default(cuid())
  incidentId  String
  roomName    String
  evidenceId  String?
  markerType  String
  title       String
  description String?
  timestamp   DateTime  @default(now())
  callOffset  Int?
  createdById String
  createdAt   DateTime  @default(now())
  createdBy   User      @relation("MarkerCreatedBy", fields: [createdById], references: [id])
  evidence    Evidence? @relation(fields: [evidenceId], references: [id])
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([roomName])
  @@index([evidenceId])
}

model MeetingRecording {
  id              String    @id @default(cuid())
  incidentId      String
  roomName        String
  title           String?
  description     String?
  fileName        String
  fileUrl         String
  firebasePath    String
  fileSize        Int
  duration        Int?      // Duration in seconds
  mimeType        String    @default("video/webm")
  recordingType   String    @default("screen") // screen, camera, mixed
  thumbnailUrl    String?
  status          String    @default("ready") // uploading, processing, ready, failed
  recordedById    String
  startedAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  
  recordedBy      User      @relation("RecordingRecordedBy", fields: [recordedById], references: [id])
  incident        Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([roomName])
  @@index([recordedById])
}

