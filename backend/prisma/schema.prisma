model BakeryAiInsight {
  id          Int      @id @default(autoincrement())
  weekName    String   @unique @db.VarChar(100)
  insightData Json     // Full GPT response (the data payload)
  chartData   Json     // _chartData for frontend charts
  metaData    Json     // _meta info (model, generatedAt, etc.)
  aiModel     String   @db.VarChar(50)
  generatedBy String   @db.VarChar(255) // user name who triggered
  generatedByUserId String? @db.VarChar(255) // user UUID
  tokenUsage  Int?     // total tokens used (if available)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekName])
  @@index([generatedByUserId])
  @@index([createdAt])
  @@map("bakery_ai_insights")
}

model BakeryAiInsightLog {
  id          Int      @id @default(autoincrement())
  weekName    String   @db.VarChar(100)
  action      String   @db.VarChar(30) // GENERATED, REGENERATED, CACHE_HIT
  aiModel     String?  @db.VarChar(50)
  tokenUsage  Int?
  userId      String?  @db.VarChar(255)
  userName    String   @db.VarChar(255)
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(500)
  durationMs  Int?     // how long the GPT call took
  success     Boolean  @default(true)
  errorMsg    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([weekName])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("bakery_ai_insight_logs")
}

// ==================== VACATION MANAGEMENT ====================

model VacationEmployee {
  id                     Int                     @id @default(autoincrement())
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  employeeCode           String?
  role                   String?
  department             String?
  shift                  String?
  workline               String?
  workarea               String?
  dateOfEmployment       DateTime?               @db.Date
  allocatedVacationHours Float?                  @default(0)
  annualAllocation       Float?                  @default(25)
  maxAccumulatedHours    Float?                  @default(0)
  yearsOfEmployment      Int?                    @default(0)
  monthsOfEmployment     Int?                    @default(0)
  vacationScheduleYears  Int[]                   @default([])
  vacationScheduleHours  Float[]                 @default([])
  supervisorId           String?
  userId                 String?
  organizationId         String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  User                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  Organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Vacations              Vacation[]
  VacationNotifications  VacationNotification[]
  VacationActivityLogs   VacationActivityLog[]

  @@index([userId])
  @@index([organizationId])
  @@index([email])
  @@index([employeeCode])
  @@map("vacation_employees")
}

model Vacation {
  id                  Int                     @id @default(autoincrement())
  employeeId          Int
  requestedByUserId   String?
  leaveType           String                  @default("vacation")
  startDate           DateTime                @db.Date
  endDate             DateTime                @db.Date
  durationDays        Int                     @default(1)
  returnToWork        DateTime?               @db.Date
  reason              String
  coveragePlan        String?
  emergencyPhone      String?
  emergencyEmail      String?
  autoApprove         Boolean                 @default(false)
  status              String                  @default("pending")
  departmentSnapshot  String?
  roleSnapshot        String?
  shiftSnapshot       String?
  worklineSnapshot    String?
  workareaSnapshot    String?
  statusHistory       Json?
  approvedByUserId    String?
  decidedAt           DateTime?
  decisionReason      String?
  organizationId      String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  Employee            VacationEmployee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  RequestedByUser     User?                   @relation("VacationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  ApprovedByUser      User?                   @relation("VacationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  Organization        Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Notifications       VacationNotification[]
  ActivityLogs        VacationActivityLog[]

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([organizationId])
  @@map("vacations")
}

model VacationSettings {
  id                          Int       @id @default(autoincrement())
  standardAllocationDays      Int       @default(0)
  minimumNoticeDays           Int       @default(0)
  maxConsecutiveDays          Int       @default(0)
  minTeamCoveragePercent      Int       @default(0)
  maxSimultaneousAbsences     Int       @default(0)
  criticalRoleCoverageRequired Boolean  @default(false)
  organizationId              String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  Organization                Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("vacation_settings")
}

model VacationBlackoutPeriod {
  id               Int       @id @default(autoincrement())
  name             String
  startDate        DateTime  @db.Date
  endDate          DateTime  @db.Date
  description      String?
  isActive         Boolean   @default(true)
  createdByUserId  String?
  organizationId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  CreatedByUser    User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  Organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([startDate])
  @@map("vacation_blackout_periods")
}

model VacationActivityLog {
  id            Int       @id @default(autoincrement())
  vacationId    Int
  employeeId    Int
  activityType  String
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  durationDays  Int?
  leaveType     String?
  status        String?
  organizationId String?
  createdAt     DateTime  @default(now())

  Vacation      Vacation          @relation(fields: [vacationId], references: [id], onDelete: Cascade)
  Employee      VacationEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Organization  Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([vacationId])
  @@index([employeeId])
  @@index([organizationId])
  @@map("vacation_activity_logs")
}

model VacationNotification {
  id                 Int       @id @default(autoincrement())
  employeeId         Int
  notificationType   String
  title              String
  message            String
  relatedVacationId  Int?
  isRead             Boolean   @default(false)
  readAt             DateTime?
  organizationId     String?
  createdAt          DateTime  @default(now())

  Employee           VacationEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  RelatedVacation    Vacation?         @relation(fields: [relatedVacationId], references: [id], onDelete: SetNull)
  Organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([relatedVacationId])
  @@index([organizationId])
  @@index([isRead])
  @@map("vacation_notifications")
}
