// ============================================================================
// MEETING INTELLIGENCE MODELS
// ============================================================================

enum MeetingStatus {
  DRAFT
  RECORDING
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  NEEDS_REVIEW
  PUBLISHED
  FAILED
}

enum MeetingType {
  GENERAL
  STANDUP
  ONE_ON_ONE
  TEAM_SYNC
  CLIENT_CALL
  INTERVIEW
  BRAINSTORM
  REVIEW
  OTHER
}

model Meeting {
  id               String        @id @default(uuid())
  title            String?
  meetingType      MeetingType   @default(GENERAL)
  status           MeetingStatus @default(DRAFT)
  
  // Location & Context
  location         String?
  locationType     String?       // On-site, Remote, Hybrid, Custom
  tags             String[]      @default([])
  language         String        @default("en")
  
  // Scheduling
  scheduledAt      DateTime?     // Scheduled date/time for the meeting
  
  // Department
  departmentId     String?
  department       Department?   @relation(fields: [departmentId], references: [id])
  
  // Meeting Purpose
  objective        String?       // Meeting objective/goal
  agendaItems      String[]      @default([])  // List of agenda items
  
  // AI Settings
  liveTranscriptionEnabled Boolean @default(true)
  aiProcessingMode String?       // ExecutiveSummary, DetailedMinutes, ActionFocused, Compliance
  confidentialityLevel String?   // Private, TeamVisible, Restricted
  
  // Recording info
  recordingUrl     String?       // Firebase Storage URL
  duration         Int?          // Duration in seconds
  recordedAt       DateTime?     // When recording started
  
  // AI Processing
  processingStartedAt DateTime?
  processingCompletedAt DateTime?
  processingError  String?
  
  // Ownership
  creatorId        String
  creator          User          @relation("MeetingCreator", fields: [creatorId], references: [id])
  
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  facilityId       String?
  facility         Facility?     @relation("MeetingFacility", fields: [facilityId], references: [id])
  
  // Timestamps
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  
  // Relations
  participants     MeetingParticipant[]
  bookmarks        MeetingBookmark[]
  transcript       TranscriptBlock[]
  summary          MeetingSummary?
  actionItems      Task[]
  attachments      MeetingAttachment[]
  consentRecords   RecordingConsentAudit[]

  @@index([creatorId])
  @@index([departmentId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model MeetingParticipant {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  userId      String?
  user        User?    @relation("MeetingParticipantUser", fields: [userId], references: [id])
  
  // For external participants without user account
  name        String?
  email       String?
  phone       String?
  
  // Speaker mapping from AI
  speakerLabel String?  // "Speaker 1", "Speaker 2", etc.
  
  createdAt   DateTime @default(now())

  @@index([meetingId])
  @@index([userId])
}

model MeetingBookmark {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  timestamp   Int      // Seconds from start
  label       String?
  note        String?
  
  createdAt   DateTime @default(now())

  @@index([meetingId])
}

model TranscriptBlock {
  id           String   @id @default(uuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  speakerLabel String   // "Speaker 1", "Speaker 2", etc.
  speakerId    String?  // Linked to MeetingParticipant if resolved
  
  content      String
  startTime    Int      // Seconds from start
  endTime      Int      // Seconds from start
  confidence   Float?   // AI confidence score
  
  createdAt    DateTime @default(now())

  @@index([meetingId])
  @@index([startTime])
}

model MeetingSummary {
  id          String   @id @default(uuid())
  meetingId   String   @unique
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  keyPoints   Json?    // Array of key points
  decisions   Json?    // Array of decisions
  risks       Json?    // Array of risks/concerns
  questions   Json?    // Array of open questions
  nextSteps   Json?    // Array of next steps
  
  // Full summary text
  executiveSummary String?
  
  // Processed Transcript (AI speaker-detected)
  rawTranscript       String?   @db.Text    // Original Whisper transcription
  processedTranscript String?   @db.Text    // AI-processed with speaker labels
  transcriptWordCount Int?                  // Word count
  transcriptDuration  Int?                  // Duration in seconds
  transcriptSavedAt   DateTime?             // When transcript was saved
  
  // AI Narrative Summary (GPT-4o generated)
  narrative       String?   @db.Text    // Full narrative summary text
  briefSummary    String?   @db.Text    // Brief one-paragraph summary
  tone            String?               // Meeting tone (e.g., "productive", "collaborative")
  objectives      Json?                 // Array of meeting objectives
  keyDiscussions  Json?                 // Array of key discussion points
  takeaways       Json?                 // Array of key takeaways
  
  // AI Audio Summary (TTS generated)
  audioUrl        String?               // Firebase Storage URL for TTS audio
  audioVoice      String?               // Voice used (onyx, echo, etc.)
  audioDuration   Int?                  // Duration in seconds
  
  // Versioning
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  editedAt    DateTime?
  editedById  String?

  @@index([meetingId])
}

model MeetingAttachment {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  
  uploadedById String
  uploadedAt  DateTime @default(now())

  @@index([meetingId])
}

// ===========================================
// CONSENT & COMPLIANCE MODELS
// For GDPR/Legal compliance on meeting recordings
// ===========================================

// Consent Policy Version - Tracks policy changes over time
model ConsentPolicy {
  id          String   @id @default(uuid())
  version     String   @unique  // e.g., "1.0.0", "1.1.0"
  title       String   @default("Meeting Recording Consent Policy")
  
  // Policy content sections
  purposeOfRecording    String   @db.Text  // Why we record
  dataRetentionPolicy   String   @db.Text  // How long data is kept
  dataSecurityPolicy    String   @db.Text  // How data is secured
  dataSharingPolicy     String   @db.Text  // Who can access data
  userRights            String   @db.Text  // User rights (deletion, access, etc.)
  
  // Full policy text (for legal reference)
  fullPolicyText        String   @db.Text
  
  // Metadata
  isActive              Boolean  @default(true)
  effectiveDate         DateTime @default(now())
  expirationDate        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String?
  
  // Audit trail
  consentRecords        RecordingConsentAudit[]

  @@index([isActive])
  @@index([version])
}

// Recording Consent Audit Log - IMMUTABLE record of consent
// This table should NEVER be updated or deleted (legal requirement)
model RecordingConsentAudit {
  id                    String   @id @default(uuid())
  
  // Meeting Reference
  meetingId             String
  meeting               Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  // User who gave consent
  userId                String
  userEmail             String
  userFirstName         String
  userLastName          String
  userPhoneNumber       String?
  
  // Policy accepted
  policyId              String
  policy                ConsentPolicy @relation(fields: [policyId], references: [id])
  policyVersion         String        // Snapshot of version at time of consent
  
  // Consent details
  consentType           ConsentType   @default(RECORDING_START)
  consentGiven          Boolean       @default(true)
  consentMethod         ConsentMethod @default(IN_APP_MODAL)
  
  // Legal verification data
  ipAddress             String?
  userAgent             String?       // Device/browser info
  deviceId              String?       // Device identifier
  deviceModel           String?       // e.g., "iPhone 15 Pro"
  osVersion             String?       // e.g., "iOS 17.2"
  appVersion            String?       // App version at time of consent
  geoLocation           String?       // Optional: City/Country for legal purposes
  
  // Confirmation that all participants were notified
  allParticipantsNotified Boolean @default(false)
  audioAnnouncementPlayed Boolean @default(false)
  
  // Cryptographic hash for tamper-proofing
  // Hash of: meetingId + userId + timestamp + policyVersion
  consentHash           String   @unique
  
  // Timestamps (immutable)
  consentTimestamp      DateTime @default(now())
  
  // For soft-delete tracking (we never actually delete)
  isRevoked             Boolean  @default(false)
  revokedAt             DateTime?
  revocationReason      String?

  @@index([meetingId])
  @@index([userId])
  @@index([consentTimestamp])
  @@index([policyVersion])
  @@index([consentHash])
}

// Consent Type Enum
enum ConsentType {
  RECORDING_START       // Consent to start recording
  RECORDING_RESUME      // Consent to resume after pause
  DATA_PROCESSING       // Consent for AI processing
  DATA_RETENTION        // Consent for data storage
  PARTICIPANT_ADDITION  // Consent when new participant joins
}

// Consent Method Enum
enum ConsentMethod {
  IN_APP_MODAL          // User clicked agree in app modal
  VERBAL                // Verbal consent (recorded)
  EMAIL                 // Email consent
  WRITTEN               // Written/signed consent
  IMPLICIT              // Implicit (stayed in meeting after announcement)
}
