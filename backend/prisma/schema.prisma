  name           String
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  description    String?
  version        Int          @default(1)
  isActive       Boolean      @default(true)
  uploadedById   String
  uploadedAt     DateTime     @default(now())
  updatedAt      DateTime
