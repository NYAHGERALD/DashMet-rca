// ============================================================================
// MEETING INTELLIGENCE MODELS
// ============================================================================

enum MeetingStatus {
  DRAFT
  RECORDING
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  NEEDS_REVIEW
  PUBLISHED
  FAILED
}

enum MeetingType {
  GENERAL
  STANDUP
  ONE_ON_ONE
  TEAM_SYNC
  CLIENT_CALL
  INTERVIEW
  BRAINSTORM
  REVIEW
  OTHER
  MANUAL
}

model Meeting {
  id               String        @id @default(uuid())
  title            String?
  meetingType      MeetingType   @default(GENERAL)
  status           MeetingStatus @default(DRAFT)
  
  // Location & Context
  location         String?
  locationType     String?       // On-site, Remote, Hybrid, Custom
  tags             String[]      @default([])
  language         String        @default("en")
  
  // Scheduling
  scheduledAt      DateTime?     // Scheduled date/time for the meeting
  
  // Department
  departmentId     String?
  department       Department?   @relation(fields: [departmentId], references: [id])
  
  // Meeting Purpose
  objective        String?       // Meeting objective/goal
  agendaItems      String[]      @default([])  // List of agenda items
  
  // AI Settings
  liveTranscriptionEnabled Boolean @default(true)
  aiProcessingMode String?       // ExecutiveSummary, DetailedMinutes, ActionFocused, Compliance
  confidentialityLevel String?   // Private, TeamVisible, Restricted
  
  // Recording info
  recordingUrl     String?       // Firebase Storage URL
  duration         Int?          // Duration in seconds
  recordedAt       DateTime?     // When recording started
  
  // AI Processing
  processingStartedAt DateTime?
  processingCompletedAt DateTime?
  processingError  String?
  
  // Ownership
  creatorId        String
  creator          User          @relation("MeetingCreator", fields: [creatorId], references: [id])
  
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  facilityId       String?
  facility         Facility?     @relation("MeetingFacility", fields: [facilityId], references: [id])
  
  // Timestamps
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  
  // Relations
  participants     MeetingParticipant[]
  bookmarks        MeetingBookmark[]
  transcript       TranscriptBlock[]
  summary          MeetingSummary?
  actionItems      Task[]
  attachments      MeetingAttachment[]
  consentRecords   RecordingConsentAudit[]

  @@index([creatorId])
  @@index([departmentId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model MeetingParticipant {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  userId      String?
  user        User?    @relation("MeetingParticipantUser", fields: [userId], references: [id])
  
  // For external participants without user account
  name        String?
  email       String?
  phone       String?
  
  // Speaker mapping from AI
  speakerLabel String?  // "Speaker 1", "Speaker 2", etc.
  
  createdAt   DateTime @default(now())

  @@index([meetingId])
  @@index([userId])
}

model MeetingBookmark {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  timestamp   Int      // Seconds from start
  label       String?
  note        String?
  
  createdAt   DateTime @default(now())

  @@index([meetingId])
}

model TranscriptBlock {
  id           String   @id @default(uuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  speakerLabel String   // "Speaker 1", "Speaker 2", etc.
  speakerId    String?  // Linked to MeetingParticipant if resolved
  
  content      String
  startTime    Int      // Seconds from start
  endTime      Int      // Seconds from start
  confidence   Float?   // AI confidence score
  
  createdAt    DateTime @default(now())

  @@index([meetingId])
  @@index([startTime])
}

model MeetingSummary {
  id          String   @id @default(uuid())
  meetingId   String   @unique
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  keyPoints   Json?    // Array of key points
  decisions   Json?    // Array of decisions
  risks       Json?    // Array of risks/concerns
  questions   Json?    // Array of open questions
  nextSteps   Json?    // Array of next steps
  
  // Full summary text
  executiveSummary String?
  
  // Processed Transcript (AI speaker-detected)
  rawTranscript       String?   @db.Text    // Original Whisper transcription
  processedTranscript String?   @db.Text    // AI-processed with speaker labels
  transcriptWordCount Int?                  // Word count
  transcriptDuration  Int?                  // Duration in seconds
  transcriptSavedAt   DateTime?             // When transcript was saved
  
  // AI Narrative Summary (GPT-4o generated)
  narrative       String?   @db.Text    // Full narrative summary text
  briefSummary    String?   @db.Text    // Brief one-paragraph summary
  tone            String?               // Meeting tone (e.g., "productive", "collaborative")
  objectives      Json?                 // Array of meeting objectives
  keyDiscussions  Json?                 // Array of key discussion points
  actionItems     Json?                 // Array of action items with assignees/deadlines
  takeaways       Json?                 // Array of key takeaways
  
  // AI Audio Summary (TTS generated)
  audioUrl        String?               // Firebase Storage URL for TTS audio
  audioVoice      String?               // Voice used (onyx, echo, etc.)
  audioDuration   Int?                  // Duration in seconds
  
  // Versioning
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  editedAt    DateTime?
  editedById  String?

  @@index([meetingId])
}

model MeetingAttachment {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  
  uploadedById String
  uploadedAt  DateTime @default(now())

  @@index([meetingId])
}

// ===========================================
// CONSENT & COMPLIANCE MODELS
// For GDPR/Legal compliance on meeting recordings
// ===========================================

// Consent Policy Version - Tracks policy changes over time
model ConsentPolicy {
  id          String   @id @default(uuid())
  version     String   @unique  // e.g., "1.0.0", "1.1.0"
  title       String   @default("Meeting Recording Consent Policy")
  
  // Policy content sections
  purposeOfRecording    String   @db.Text  // Why we record
  dataRetentionPolicy   String   @db.Text  // How long data is kept
  dataSecurityPolicy    String   @db.Text  // How data is secured
  dataSharingPolicy     String   @db.Text  // Who can access data
  userRights            String   @db.Text  // User rights (deletion, access, etc.)
  
  // Full policy text (for legal reference)
  fullPolicyText        String   @db.Text
  
  // Metadata
  isActive              Boolean  @default(true)
  effectiveDate         DateTime @default(now())
  expirationDate        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String?
  
  // Audit trail
  consentRecords        RecordingConsentAudit[]

  @@index([isActive])
  @@index([version])
}

// Recording Consent Audit Log - IMMUTABLE record of consent
// This table should NEVER be updated or deleted (legal requirement)
model RecordingConsentAudit {
  id                    String   @id @default(uuid())
  
  // Meeting Reference
  meetingId             String
  meeting               Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  // User who gave consent
  userId                String
  userEmail             String
  userFirstName         String
  userLastName          String
  userPhoneNumber       String?
  
  // Policy accepted
  policyId              String
  policy                ConsentPolicy @relation(fields: [policyId], references: [id])
  policyVersion         String        // Snapshot of version at time of consent
  
  // Consent details
  consentType           ConsentType   @default(RECORDING_START)
  consentGiven          Boolean       @default(true)
  consentMethod         ConsentMethod @default(IN_APP_MODAL)
  
  // Legal verification data
  ipAddress             String?
  userAgent             String?       // Device/browser info
  deviceId              String?       // Device identifier
  deviceModel           String?       // e.g., "iPhone 15 Pro"
  osVersion             String?       // e.g., "iOS 17.2"
  appVersion            String?       // App version at time of consent
  geoLocation           String?       // Optional: City/Country for legal purposes
  
  // Confirmation that all participants were notified
  allParticipantsNotified Boolean @default(false)
  audioAnnouncementPlayed Boolean @default(false)
  
  // Cryptographic hash for tamper-proofing
  // Hash of: meetingId + userId + timestamp + policyVersion
  consentHash           String   @unique
  
  // Timestamps (immutable)
  consentTimestamp      DateTime @default(now())
  
  // For soft-delete tracking (we never actually delete)
  isRevoked             Boolean  @default(false)
  revokedAt             DateTime?
  revocationReason      String?

  @@index([meetingId])
  @@index([userId])
  @@index([consentTimestamp])
  @@index([policyVersion])
  @@index([consentHash])
}

// Consent Type Enum
enum ConsentType {
  RECORDING_START       // Consent to start recording
  RECORDING_RESUME      // Consent to resume after pause
  DATA_PROCESSING       // Consent for AI processing
  DATA_RETENTION        // Consent for data storage
  PARTICIPANT_ADDITION  // Consent when new participant joins
}

// Consent Method Enum
enum ConsentMethod {
  IN_APP_MODAL          // User clicked agree in app modal
  VERBAL                // Verbal consent (recorded)
  EMAIL                 // Email consent
  WRITTEN               // Written/signed consent
  IMPLICIT              // Implicit (stayed in meeting after announcement)
}

// ==========================================
// CONFLICT RESOLUTION MODELS (ENCRYPTED)
// ==========================================

// Case Type Enum
enum ConflictCaseType {
  CONFLICT
  CONDUCT
  SAFETY
  OTHER
}

// Case Status Enum
enum ConflictCaseStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  AWAITING_ACTION
  CLOSED
  ESCALATED
}

// Case Closure Reason Enum
enum CaseClosureReason {
  RESOLVED
  NO_FURTHER_ACTION
  EMPLOYEE_SEPARATION
  COMPLAINT_WITHDRAWN
  INSUFFICIENT_EVIDENCE
  OTHER
}

// Document Type Enum
enum ConflictDocumentType {
  COMPLAINT_A
  COMPLAINT_B
  WITNESS_STATEMENT
  PRIOR_RECORD
  COUNSELING_RECORD
  WARNING_DOCUMENT
  EVIDENCE
  OTHER
}

// Recommended Action Enum
enum RecommendedActionType {
  COACHING
  COUNSELING
  WRITTEN_WARNING
  ESCALATE_TO_HR
}

// Comparison Status Enum
enum ComparisonStatusType {
  AGREEMENT
  CONTRADICTION
  PARTIAL
  UNCLEAR
}

// Conflict Case - Main Model (All sensitive fields encrypted)
model ConflictCase {
  id                    String                      @id @default(uuid())
  caseNumber            String                      @unique
  type                  ConflictCaseType
  status                ConflictCaseStatus          @default(DRAFT)
  description           String?                     @db.Text // Encrypted - Case description
  incidentDate          DateTime
  location              String                      // Encrypted
  department            String                      // Encrypted
  shift                 String?                     // Encrypted
  
  // AI Analysis Results (Encrypted JSON)
  comparisonResult      String?                     @db.Text // Encrypted JSON
  policyMatches         String?                     @db.Text // Encrypted JSON  
  recommendations       String?                     @db.Text // Encrypted JSON
  policyMatchingResult  String?                     @db.Text // Encrypted JSON - Full policy matching result for UI
  recommendationResult  String?                     @db.Text // Encrypted JSON - Full recommendation result for UI
  
  // Selected Action
  selectedAction                  RecommendedActionType?
  selectedTargetEmployeeIds       String?                     @db.Text // JSON array of employee IDs targeted by the action
  generatedDocument               String?                     @db.Text // Encrypted JSON
  fullGeneratedDocumentResult     String?                     @db.Text // Encrypted JSON - Full generated document for UI display
  employeeGeneratedDocuments      String?                     @db.Text // Encrypted JSON - Per-employee generated documents map
  approvedEmployeeNames           String?                     @db.Text // JSON array of employee names whose documents have been approved
  
  // Company Logo (Firebase Storage URL)
  companyLogoUrl        String?                     @db.Text
  
  // Supervisor Notes (Encrypted)
  supervisorNotes       String?                     @db.Text
  
  // Case Closure Details
  closureReason         String?                     // Encrypted - reason for closing
  closureSummary        String?                     @db.Text // Encrypted - final closure summary
  closedBy              String?                     // User ID who closed the case
  closedByUser          User?                       @relation("CaseClosure", fields: [closedBy], references: [id])
  isLocked              Boolean                     @default(false) // Prevents further edits
  
  // Workplace Policy Reference
  activePolicyId        String?
  workplacePolicy       WorkplacePolicyDoc?         @relation(fields: [activePolicyId], references: [id])
  
  // Audit & Metadata
  createdBy             String
  createdByUser         User?                       @relation("CaseCreator", fields: [createdBy], references: [id])
  organizationId        String
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilityId            String?
  facility              Facility?                   @relation(fields: [facilityId], references: [id])
  
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  closedAt              DateTime?
  
  // Relations
  involvedEmployees     ConflictInvolvedEmployee[]
  documents             ConflictCaseDocument[]
  auditLog              ConflictCaseAuditEntry[]
  // Note: documentEdits relation removed - edit history uses caseId as plain string reference
  
  @@index([organizationId])
  @@index([facilityId])
  @@index([createdBy])
  @@index([status])
  @@index([type])
  @@index([caseNumber])
  @@index([incidentDate])
}

// Document Edit History (for tracking changes to generated documents)
// Note: caseId is NOT a foreign key - edits can be stored for cases that only exist locally in the app
model ConflictDocumentEdit {
  id              String          @id @default(uuid())
  caseId          String          // UUID of the case (may be local-only, not in DB)
  
  sectionId       String          // e.g., "expectations", "incidentSummary"
  sectionTitle    String          // e.g., "Expectations", "Incident Summary" (Encrypted)
  originalContent String          @db.Text // Encrypted
  newContent      String          @db.Text // Encrypted
  editedBy        String          // Encrypted - name or ID of editor
  
  createdAt       DateTime        @default(now())
  
  @@index([caseId])
  @@index([createdAt])
}

// Document Review Comments (for supervisor review feedback)
// Note: caseId is NOT a foreign key - comments can be stored for cases that only exist locally in the app
model ConflictReviewComment {
  id              String          @id @default(uuid())
  caseId          String          // UUID of the case (may be local-only, not in DB)
  
  section         String          // Section ID the comment is attached to
  comment         String          @db.Text // Encrypted - The comment text
  createdBy       String          // Encrypted - name or ID of commenter
  isResolved      Boolean         @default(false)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([caseId])
  @@index([isResolved])
  @@index([createdAt])
}

// Involved Employee (Encrypted)
model ConflictInvolvedEmployee {
  id              String          @id @default(uuid())
  caseId          String
  case            ConflictCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  name            String          // Encrypted
  role            String          // Encrypted
  department      String          // Encrypted
  employeeFileNo  String?         // Encrypted - Employee ID / File Number
  isComplainant   Boolean         @default(false)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relation to documents (for witness statements)
  documents       ConflictCaseDocument[]
  
  @@index([caseId])
}

// Case Document (Encrypted)
model ConflictCaseDocument {
  id                              String                    @id @default(uuid())
  caseId                          String
  case                            ConflictCase              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  type                            ConflictDocumentType
  
  // Image Storage (URLs or encrypted base64)
  originalImageUrls               String?                   @db.Text // Encrypted JSON array
  processedImageUrls              String?                   @db.Text // Encrypted JSON array
  originalImageData               String?                   @db.Text // Encrypted base64
  processedImageData              String?                   @db.Text // Encrypted base64
  
  // Text Content (All Encrypted)
  originalText                    String?                   @db.Text
  translatedText                  String?                   @db.Text
  cleanedText                     String?                   @db.Text
  
  // Metadata
  detectedLanguage                String?
  isHandwritten                   Boolean?
  pageCount                       Int                       @default(1)
  
  // Associated Employee (for witness statements)
  employeeId                      String?
  employee                        ConflictInvolvedEmployee? @relation(fields: [employeeId], references: [id])
  submittedBy                     String?                   // Encrypted - Name of submitter
  
  // Digital Signature & Audit Log Fields (All Encrypted)
  signatureImageData              String?                   @db.Text // Encrypted PNG base64
  employeeReviewTimestamp         DateTime?
  employeeSignatureTimestamp      DateTime?
  supervisorCertificationTimestamp DateTime?
  supervisorId                    String?                   // Encrypted
  supervisorName                  String?                   // Encrypted
  submittedById                   String?                   // Encrypted
  deviceId                        String?
  appVersion                      String?
  versionHash                     String?                   // Hash for document integrity
  
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  
  @@index([caseId])
  @@index([type])
  @@index([employeeId])
}

// Case Audit Entry
model ConflictCaseAuditEntry {
  id          String        @id @default(uuid())
  caseId      String
  case        ConflictCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  action      String
  details     String        @db.Text // Encrypted
  userId      String
  userName    String        // Encrypted
  
  timestamp   DateTime      @default(now())
  
  @@index([caseId])
  @@index([timestamp])
  @@index([userId])
}

// Workplace Policy Document (for conflict resolution reference)
model WorkplacePolicyDoc {
  id                String                @id @default(uuid())
  name              String
  version           String
  effectiveDate     DateTime
  status            String                @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  description       String?               @db.Text
  
  // Document Source (Encrypted)
  documentFileName  String?
  documentFileUrl   String?               @db.Text
  documentFileType  String?
  documentPageCount Int?
  originalText      String?               @db.Text // Encrypted
  
  // Parsed Sections (Encrypted JSON)
  // Each section includes: firstProgression, secondProgression, thirdProgression, fourthProgression
  sections          String?               @db.Text // Encrypted JSON array
  
  // Audit
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilityId        String?
  facility          Facility?             @relation(fields: [facilityId], references: [id])
  createdBy         String
  createdByUser     User?                 @relation("PolicyCreator", fields: [createdBy], references: [id])
  
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  
  // Relations
  cases             ConflictCase[]
  
  @@index([organizationId])
  @@index([status])
  @@index([createdBy])
}

// ============================================================================
// LEADER STANDARD WORK (LSW) MODELS
// ============================================================================

// LSW Enums
enum LswFrequency {
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum LswTrend {
  UP
  DOWN
  STABLE
}

enum LswKeyResultScope {
  PLANT
  CORPORATE
  DEPARTMENT
  CUSTOM
}

enum LswDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ─────────────────────────────────────────────────────────────────────────────
// LswBoard: Master container for a user's LSW page per week
// Stores page-level settings and preferences
// ─────────────────────────────────────────────────────────────────────────────
model LswBoard {
  id               String        @id @default(uuid())
  
  // Ownership & Scoping
  userId           String
  user             User          @relation("LswBoardOwner", fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization  @relation("LswBoardOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  facilityId       String?
  facility         Facility?     @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department?   @relation("LswBoardDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  
  // Week Context
  weekNumber       Int
  year             Int
  
  // Page-Level Preferences
  selectedDay      LswDayOfWeek  @default(MONDAY)
  todoTab          String        @default("today")  // 'today' | 'thisWeek'
  
  // Timestamps
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  @@unique([userId, weekNumber, year])
  @@index([userId])
  @@index([organizationId])
  @@index([facilityId])
  @@index([departmentId])
  @@index([weekNumber, year])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswDepartment: Organization-managed LSW department options
// Replaces the hardcoded departments array on the LSW page
// ─────────────────────────────────────────────────────────────────────────────
model LswDepartment {
  id              String        @id @default(uuid())
  name            String
  code            String        // Short code like 'production', 'quality', etc.
  description     String?
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  
  // Scoping
  organizationId  String
  organization    Organization  @relation("LswDepartmentOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  facilityId      String?
  facility        Facility?     @relation("LswDepartmentFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([facilityId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswDailyTask: Daily & Weekly Standard Tasks/Meetings
// Each row in the daily task table with time, minutes, and day-of-week toggles
// ─────────────────────────────────────────────────────────────────────────────
model LswDailyTask {
  id              String        @id @default(uuid())
  
  // Ownership & Scoping
  userId          String
  user            User          @relation("LswDailyTaskUser", fields: [userId], references: [id], onDelete: Cascade)
  facilityId      String?
  facility        Facility?     @relation("LswDailyTaskFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department?   @relation("LswDailyTaskDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  
  // Task Data
  task            String
  minutes         Int           @default(15)
  time            String        // HH:MM format, e.g. "06:00"
  
  // Day-of-Week Schedule (legacy / defaults – actual completions stored in LswDailyTaskCompletion)
  monday          Boolean       @default(false)
  tuesday         Boolean       @default(false)
  wednesday       Boolean       @default(false)
  thursday        Boolean       @default(false)
  friday          Boolean       @default(false)
  saturday        Boolean       @default(false)
  sunday          Boolean       @default(false)
  
  // Ordering
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Per-week completions
  completions     LswDailyTaskCompletion[]
  earlyCompletionLogs LswEarlyCompletionLog[]
  
  @@index([userId])
  @@index([facilityId])
  @@index([departmentId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswDailyTaskCompletion: Per-week checkbox state for daily tasks
// Each record tracks which days are checked off for a specific task in a specific week
// ─────────────────────────────────────────────────────────────────────────────
model LswDailyTaskCompletion {
  id              String        @id @default(uuid())
  
  // Link to the task
  dailyTaskId     String
  dailyTask       LswDailyTask  @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  
  // Week Context
  weekNumber      Int
  year            Int
  
  // Day-of-Week Completion
  monday          Boolean       @default(false)
  tuesday         Boolean       @default(false)
  wednesday       Boolean       @default(false)
  thursday        Boolean       @default(false)
  friday          Boolean       @default(false)
  saturday        Boolean       @default(false)
  sunday          Boolean       @default(false)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@unique([dailyTaskId, weekNumber, year])
  @@index([dailyTaskId])
  @@index([weekNumber, year])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswEarlyCompletionLog: Tracks tasks marked as "Early Completed"
// When a user marks a future task as completed early, this logs the event
// ─────────────────────────────────────────────────────────────────────────────
model LswEarlyCompletionLog {
  id              String        @id @default(uuid())

  // Who completed it
  userId          String
  user            User          @relation("LswEarlyCompletionLogUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String

  // Which task
  dailyTaskId     String
  dailyTask       LswDailyTask  @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)

  // Context
  taskName        String        // Snapshot of task name at time of early completion
  taskTime        String        // Scheduled time (HH:MM)
  dayKey          String        // Day key: M, T, W, H, F, S1, S2
  dayLabel        String        // Human-readable: Mon, Tue, Wed, etc.
  weekNumber      Int
  year            Int
  scheduledDate   DateTime      // The actual date the task was scheduled for

  // Timestamps
  completedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([dailyTaskId])
  @@index([weekNumber, year])
  @@map("lsw_early_completion_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// LswTodoItem: To-Do Today & This Week items
// Checkbox list with completion tracking
// ─────────────────────────────────────────────────────────────────────────────
model LswTodoItem {
  id              String        @id @default(uuid())
  
  // Ownership & Scoping
  userId          String
  user            User          @relation("LswTodoItemUser", fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?   @relation("LswTodoItemDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  
  // Item Data
  task            String
  completed       Boolean       @default(false)
  completedAt     DateTime?
  dueDate         String?       // Used as time HH:MM or date depending on context
  
  // Week Context
  weekNumber      Int?
  year            Int?
  
  // Ordering
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([userId])
  @@index([departmentId])
  @@index([completed])
  @@index([weekNumber, year])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswFrequencyTask: Scheduled Tasks/Meetings (Bi-Weekly, Monthly, etc.)
// Tasks grouped by frequency with duration and due date
// ─────────────────────────────────────────────────────────────────────────────
model LswFrequencyTask {
  id              String        @id @default(uuid())
  
  // Ownership & Scoping
  userId          String
  user            User          @relation("LswFrequencyTaskUser", fields: [userId], references: [id], onDelete: Cascade)
  facilityId      String?
  facility        Facility?     @relation("LswFrequencyTaskFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Task Data
  task            String
  minutes         Int           @default(60)
  dueDate         DateTime
  frequency       LswFrequency
  
  // Period-based scoping (e.g., "BW-4-2026", "M-3-2026", "Q-1-2026", "A-2026")
  periodKey       String?
  
  // Ordering
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([userId])
  @@index([facilityId])
  @@index([frequency])
  @@index([dueDate])
  @@index([periodKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswProject: Improvement Projects and Updates
// Supports rich styling per project and per update
// ─────────────────────────────────────────────────────────────────────────────
model LswProject {
  id                          String             @id @default(uuid())
  
  // Ownership & Scoping
  userId                      String
  user                        User               @relation("LswProjectUser", fields: [userId], references: [id], onDelete: Cascade)
  facilityId                  String?
  facility                    Facility?          @relation("LswProjectFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Project Data
  name                        String
  
  // Project Name Cell Styling
  fontColor                   String?            @default("#1f2937")
  fontFamily                  String?            @default("Inter")
  fontBold                    Boolean            @default(false)
  fontItalic                  Boolean            @default(false)
  cellColor                   String?            @default("#3b82f6")
  cellColorIntensity          Int                @default(20)
  
  // Default Update Column Styling (applied to newly created updates)
  defaultUpdateFontColor      String?            @default("#4b5563")
  defaultUpdateFontItalic     Boolean            @default(false)
  defaultUpdateCellColor      String?            @default("#10b981")
  defaultUpdateCellColorIntensity Int            @default(10)
  
  // Ordering
  sortOrder                   Int                @default(0)
  isActive                    Boolean            @default(true)
  
  // Timestamps
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  
  // Relations
  updates                     LswProjectUpdate[]
  
  @@index([userId])
  @@index([facilityId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswProjectUpdate: Individual updates within an Improvement Project
// Each project can have multiple updates with individual styling
// ─────────────────────────────────────────────────────────────────────────────
model LswProjectUpdate {
  id                  String      @id @default(uuid())
  
  // Parent Project
  projectId           String
  project             LswProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Update Data
  text                String      @default("")   @db.Text
  
  // Per-Update Styling
  fontColor           String?
  fontItalic          Boolean     @default(false)
  cellColor           String?
  cellColorIntensity  Int?
  
  // Ordering
  sortOrder           Int         @default(0)
  
  // Timestamps
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  @@index([projectId])
  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswMeetingRail: Level 1, 2 & 3 Meeting Rails
// Checkbox list with due dates and completion tracking
// ─────────────────────────────────────────────────────────────────────────────
model LswMeetingRail {
  id              String        @id @default(uuid())
  
  // Ownership & Scoping
  userId          String
  user            User          @relation("LswMeetingRailUser", fields: [userId], references: [id], onDelete: Cascade)
  facilityId      String?
  facility        Facility?     @relation("LswMeetingRailFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Rail Data
  rail            String        // e.g. "Level 1 - Daily Accountability"
  dueDate         DateTime
  completed       Boolean       @default(false)
  completedAt     DateTime?
  
  // Week Context
  weekNumber      Int?
  year            Int?
  
  // Ordering
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([userId])
  @@index([facilityId])
  @@index([completed])
  @@index([weekNumber, year])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswFollowUp: Follow Up items with responsible person tracking
// ─────────────────────────────────────────────────────────────────────────────
model LswFollowUp {
  id                String        @id @default(uuid())
  
  // Ownership & Scoping
  userId            String
  user              User          @relation("LswFollowUpUser", fields: [userId], references: [id], onDelete: Cascade)
  facilityId        String?
  facility          Facility?     @relation("LswFollowUpFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Follow Up Data
  task              String
  dueDate           DateTime
  responsibleUserId String?
  responsibleUser   User?         @relation("LswFollowUpResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  responsibleName   String?       // Free-text fallback when user isn't in system
  comments          String?       @db.Text
  
  // Status
  completed         Boolean       @default(false)
  completedAt       DateTime?
  
  // Ordering
  sortOrder         Int           @default(0)
  isActive          Boolean       @default(true)
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([userId])
  @@index([facilityId])
  @@index([responsibleUserId])
  @@index([dueDate])
  @@index([completed])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswKeyResultSet: Container for Key Result groups
// Maps to sections like "Plant Metrics" (Don Miguel) or "Corporate Metrics" (MegaMex)
// ─────────────────────────────────────────────────────────────────────────────
model LswKeyResultSet {
  id              String            @id @default(uuid())
  
  // Ownership & Scoping
  userId          String
  user            User              @relation("LswKeyResultSetUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization      @relation("LswKeyResultSetOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  facilityId      String?
  facility        Facility?         @relation("LswKeyResultSetFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Set Metadata
  name            String            // e.g. "Plant Metrics", "Corporate Metrics"
  scope           LswKeyResultScope @default(PLANT)
  description     String?
  icon            String?           // Emoji or icon identifier
  
  // Ordering
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  
  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  keyResults      LswKeyResult[]
  
  @@index([userId])
  @@index([organizationId])
  @@index([facilityId])
  @@index([scope])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswKeyResult: Individual key result metrics
// Metric/value/target/trend data within a key result set
// ─────────────────────────────────────────────────────────────────────────────
model LswKeyResult {
  id              String          @id @default(uuid())
  
  // Parent Set
  keyResultSetId  String
  keyResultSet    LswKeyResultSet @relation(fields: [keyResultSetId], references: [id], onDelete: Cascade)
  
  // Metric Data
  metric          String          // e.g. "TCIR", "Quality CPM", "Net Sales"
  value           String          // Current value (string to support formats like "$845M")
  target          String?         // Target value
  trend           LswTrend?       // UP, DOWN, STABLE
  
  // Ordering
  sortOrder       Int             @default(0)
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([keyResultSetId])
  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswPersonalGoal: Personal Objectives/Goals with progress tracking
// ─────────────────────────────────────────────────────────────────────────────
model LswPersonalGoal {
  id              String        @id @default(uuid())
  
  // Ownership & Scoping
  userId          String
  user            User          @relation("LswPersonalGoalUser", fields: [userId], references: [id], onDelete: Cascade)
  facilityId      String?
  facility        Facility?     @relation("LswPersonalGoalFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Goal Data
  objective       String
  dueDate         DateTime
  progress        Int           @default(0)  // 0-100 percentage
  
  // Ordering
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([userId])
  @@index([facilityId])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswRcaTrigger: Plant Specific Cause RCA Triggers
// Organization-level trigger definitions with per-user event tracking
// ─────────────────────────────────────────────────────────────────────────────
model LswRcaTrigger {
  id              String        @id @default(uuid())
  
  // Ownership & Scoping
  userId          String
  user            User          @relation("LswRcaTriggerUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization  @relation("LswRcaTriggerOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  facilityId      String?
  facility        Facility?     @relation("LswRcaTriggerFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  
  // Trigger Data
  trigger         String        // e.g. "People Safety - OSHA recordable"
  eventDate       DateTime?
  comments        String?       @db.Text
  
  // Ordering
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([userId])
  @@index([organizationId])
  @@index([facilityId])
  @@index([eventDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// LswStylePreset: Reusable style presets for fonts, colors, etc.
// Stores the color/font option palettes per organization
// ─────────────────────────────────────────────────────────────────────────────
model LswStylePreset {
  id              String        @id @default(uuid())
  
  // Scoping
  organizationId  String
  
  // Preset Identity
  name            String        // e.g. "Project Font Colors", "Cell Colors", "Font Families"
  category        String        // 'fontColor' | 'cellColor' | 'fontFamily'
  context         String        // 'project' | 'update' | 'general'
  
  // Preset Values (JSON array of options)
  // For fontColor: ["#1f2937", "#dc2626", "#16a34a", ...]
  // For cellColor: ["#3b82f6", "#22c55e", "#eab308", ...]
  // For fontFamily: ["Inter", "Arial", "Georgia", ...]
  values          Json
  
  // Defaults
  isDefault       Boolean       @default(false)
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@unique([organizationId, name, category, context])
  @@index([organizationId])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────────────────────
// Microsoft Outlook Calendar Integration
// Stores OAuth tokens for Microsoft Graph API calendar access (per user).
// ─────────────────────────────────────────────────────────────────────────────
model MicrosoftOAuthToken {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  accessToken            String    @db.Text
  refreshToken           String    @db.Text
  tokenExpiry            DateTime
  scope                  String?   // Granted scopes
  microsoftEmail         String?   // The Microsoft account email used
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User      @relation("MicrosoftOAuthTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

