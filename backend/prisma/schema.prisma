generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessCode {
  id        String   @id @default(uuid())
  code      String   @unique
  role      UserRole
  isActive  Boolean  @default(true)
  usedCount Int      @default(0)
  maxUses   Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([role])
}

model ArchivedChatMessage {
  id                String            @id @default(uuid())
  originalMessageId String
  incidentId        String
  userId            String
  content           String
  messageType       ChatMessageType   @default(TEXT)
  replyToId         String?
  isEdited          Boolean           @default(false)
  attachments       Json?
  mentions          String[]          @default([])
  isPinned          Boolean           @default(false)
  pinnedAt          DateTime?
  pinnedById        String?
  actionItemId      String?
  evidenceId        String?
  handoffData       Json?
  rcaAnalysisId     String?
  rcaItemId         String?
  rcaItemType       String?
  statusChange      Json?
  announcementData  Json?
  decisionData      Json?
  questionData      Json?
  updateData        Json?
  originalCreatedAt DateTime
  archivedAt        DateTime          @default(now())
  archiveReason     ChatArchiveReason @default(TEAM_TO_PRIVATE)
  archivedByUserId  String
  archiveBatchId    String
  senderFirstName   String
  senderLastName    String
  senderEmail       String
  Incident          Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([archiveBatchId])
  @@index([archivedAt])
  @@index([incidentId])
  @@index([originalCreatedAt])
}

model Area {
  id           String      @id @default(uuid())
  name         String
  description  String?
  facilityId   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  departmentId String?
  Department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  Facility     Facility?   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  Incident     Incident[]
  Line         Line[]

  @@index([departmentId])
  @@index([facilityId])
}

model AssignmentRule {
  id                 String        @id @default(uuid())
  name               String
  description        String?
  organizationId     String
  isActive           Boolean       @default(true)
  priority           Int           @default(0)
  incidentType       IncidentType?
  categoryId         String?
  facilityId         String?
  areaId             String?
  severity           Severity?
  assignToUserId     String?
  assignToRole       UserRole?
  slaResponseHours   Int?
  slaResolutionHours Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([incidentType])
  @@index([organizationId, isActive])
  @@index([severity])
}

model AuditLog {
  id             String        @id @default(uuid())
  action         AuditAction
  entity         String
  entityId       String
  userId         String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organizationId String?
  Organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User?         @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([organizationId])
  @@index([userId])
}

model CAPAction {
  id                      String         @id @default(uuid())
  actionType              ActionType
  title                   String
  description             String
  status                  ActionStatus   @default(PLANNED)
  priority                ActionPriority
  ownerId                 String
  dueDate                 DateTime
  completedAt             DateTime?
  effectivenessReviewDate DateTime?
  effectivenessScore      Int?
  isEffective             Boolean?
  recurrenceDetected      Boolean        @default(false)
  aiQualityScore          Float?
  aiWeaknessFlags         String[]
  resourceImpact          String?
  rcaAnalysisId           String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  completedById           String?
  completionEvidence      String?
  completionNotes         String?
  implementationNotes     String?
  implementationPlan      String?
  startedAt               DateTime?
  startedById             String?
  verificationNotes       String?
  verifiedAt              DateTime?
  verifiedById            String?
  regulatoryTags          String[]
  User                    User           @relation(fields: [ownerId], references: [id])
  RCAAnalysis             RCAAnalysis?   @relation(fields: [rcaAnalysisId], references: [id], onDelete: Cascade)
  CAPAuditLog             CAPAuditLog[]

  @@index([ownerId])
  @@index([rcaAnalysisId])
  @@index([status])
}

model CAPAuditLog {
  id              String    @id @default(uuid())
  capActionId     String
  action          String
  previousStatus  String?
  newStatus       String?
  previousData    Json?
  newData         Json?
  notes           String?
  evidence        String?
  performedById   String
  performedByName String
  performedAt     DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  CAPAction       CAPAction @relation(fields: [capActionId], references: [id], onDelete: Cascade)

  @@index([capActionId])
  @@index([performedAt])
  @@index([performedById])
}

model Category {
  id               String       @id @default(uuid())
  type             IncidentType
  name             String
  parentId         String?
  allowCustomTitle Boolean      @default(false)
  organizationId   String
  sortOrder        Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  Organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Category         Category?    @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category   Category[]   @relation("CategoryToCategory")
  Incident         Incident[]

  @@index([organizationId, type])
  @@index([parentId])
}

model ChatMessage {
  id                  String                @id @default(uuid())
  incidentId          String
  userId              String
  content             String
  messageType         ChatMessageType       @default(TEXT)
  replyToId           String?
  isEdited            Boolean               @default(false)
  isDeleted           Boolean               @default(false)
  attachments         Json?
  readBy              String[]              @default([])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  isPinned            Boolean               @default(false)
  mentions            String[]              @default([])
  pinnedAt            DateTime?
  pinnedById          String?
  actionItemId        String?
  evidenceId          String?
  handoffData         Json?
  rcaAnalysisId       String?
  rcaItemId           String?
  rcaItemType         String?
  statusChange        Json?
  announcementData    Json?
  decisionData        Json?
  questionData        Json?
  updateData          Json?
  Incident            Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ChatMessage         ChatMessage?          @relation("ChatMessageToChatMessage", fields: [replyToId], references: [id])
  other_ChatMessage   ChatMessage[]         @relation("ChatMessageToChatMessage")
  User                User                  @relation(fields: [userId], references: [id])
  ChatMessageReaction ChatMessageReaction[]

  @@index([actionItemId])
  @@index([createdAt])
  @@index([evidenceId])
  @@index([incidentId])
  @@index([isPinned])
  @@index([messageType])
  @@index([rcaAnalysisId])
  @@index([userId])
}

model ChatMessageReaction {
  id          String      @id @default(uuid())
  messageId   String
  userId      String
  emoji       String
  createdAt   DateTime    @default(now())
  ChatMessage ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageTemplate {
  id         String    @id @default(uuid())
  userId     String
  name       String
  category   String    @default("general")
  content    String
  isGlobal   Boolean   @default(false)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([isGlobal])
  @@index([userId])
}

model Comment {
  id            String       @id @default(uuid())
  content       String
  userId        String
  incidentId    String?
  rcaAnalysisId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Incident      Incident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  RCAAnalysis   RCAAnalysis? @relation(fields: [rcaAnalysisId], references: [id], onDelete: Cascade)
  User          User         @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([rcaAnalysisId])
  @@index([userId])
}

model DefaultPrivilege {
  id          String          @id @default(uuid())
  role        UserRole
  module      FeatureModule
  featureKey  String
  action      PrivilegeAction
  isEnabled   Boolean         @default(true)
  description String?
  displayName String?
  category    String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([role, featureKey])
  @@index([featureKey])
  @@index([module])
  @@index([role])
}

model Department {
  id                        String                      @id @default(uuid())
  name                      String
  description               String?
  facilityId                String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  Area                      Area[]
  Facility                  Facility                    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  Incident                  Incident[]
  WorkplaceSafetyAssessment WorkplaceSafetyAssessment[]

  @@index([facilityId])
}

model DropdownOption {
  id             String       @id @default(uuid())
  optionType     DropdownType
  value          String
  label          String
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)
  isRequired     Boolean      @default(false)
  placeholder    String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, optionType, value])
  @@index([optionType])
  @@index([organizationId, optionType])
}

model Evidence {
  id                String              @id @default(uuid())
  type              EvidenceType
  fileName          String
  filePath          String
  fileSize          Int
  mimeType          String
  transcription     String?
  incidentId        String?
  rcaAnalysisId     String?
  uploadedById      String
  uploadedAt        DateTime            @default(now())
  DiscussionMarker  DiscussionMarker[]
  Incident          Incident?           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  RCAAnalysis       RCAAnalysis?        @relation(fields: [rcaAnalysisId], references: [id], onDelete: Cascade)
  EvidenceSpotlight EvidenceSpotlight[]

  @@index([incidentId])
  @@index([rcaAnalysisId])
}

model FMIRAuditReport {
  id                      String                  @id @default(uuid())
  fmirId                  String
  reportNumber            String
  organizationId          String
  canBeClosed             Boolean
  auditScore              Int
  overallVerdict          String
  passesAudit             Boolean
  congratulations         Boolean                 @default(false)
  blockingReasons         String[]                @default([])
  summary                 Json
  reportSummary           Json
  answerQuality           Json
  contentQuality          Json
  evidenceAnalysis        Json
  regulatoryReadiness     Json
  fieldValidation         Json
  improvementAreas        Json
  auditorNarrative        String
  closingStatement        String
  auditedById             String
  auditDurationMs         Int?
  aiModel                 String?
  createdAt               DateTime                @default(now())
  User                    User                    @relation(fields: [auditedById], references: [id])
  ForeignMaterialIncident ForeignMaterialIncident @relation(fields: [fmirId], references: [id], onDelete: Cascade)
  Organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([auditScore])
  @@index([auditedById])
  @@index([canBeClosed])
  @@index([createdAt])
  @@index([fmirId])
  @@index([organizationId])
}

model FMIRComment {
  id                      String                  @id @default(uuid())
  fmirId                  String
  sectionNumber           Int
  content                 String
  authorId                String
  visibleToIds            String[]                @default([])
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  User                    User                    @relation(fields: [authorId], references: [id])
  ForeignMaterialIncident ForeignMaterialIncident @relation(fields: [fmirId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([fmirId])
  @@index([sectionNumber])
}

model FMIREvidence {
  id                      String                  @id @default(uuid())
  fmirId                  String
  type                    EvidenceType
  fileName                String
  filePath                String
  fileSize                Int
  mimeType                String
  description             String?
  uploadedById            String
  uploadedAt              DateTime                @default(now())
  ForeignMaterialIncident ForeignMaterialIncident @relation(fields: [fmirId], references: [id], onDelete: Cascade)

  @@index([fmirId])
}

model FMIRAIValidation {
  id                       String                  @id @default(uuid())
  fmirId                   String                  @unique
  complianceScore          Int
  overallCompliance        String
  summary                  String
  aiExplanation            String?
  fieldAnalysis            Json
  evidenceAnalysis         Json
  causeAnalysis            Json?
  correctiveActionAnalysis Json?
  productHoldAnalysis      Json?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  ForeignMaterialIncident  ForeignMaterialIncident @relation(fields: [fmirId], references: [id], onDelete: Cascade)

  @@index([fmirId])
  @@index([complianceScore])
  @@index([createdAt])
}

model Facility {
  id                        String                      @id @default(uuid())
  name                      String
  timezone                  String                      @default("America/New_York")
  address                   String?
  organizationId            String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  Area                      Area[]
  Department                Department[]
  Organization              Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ForeignMaterialIncident   ForeignMaterialIncident[]
  Incident                  Incident[]
  RegulatoryTracking        RegulatoryTracking[]
  Shift                     Shift[]
  WorkplaceSafetyAssessment WorkplaceSafetyAssessment[]

  @@index([organizationId])
}

model FieldConfiguration {
  id             String       @id @default(uuid())
  incidentType   String
  fieldName      String
  fieldLabel     String
  fieldType      String
  isRequired     Boolean      @default(false)
  placeholder    String?
  helpText       String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, incidentType, fieldName])
  @@index([incidentType])
  @@index([organizationId, incidentType])
}

model ForeignMaterialIncident {
  id                                               String            @id @default(uuid())
  reportNumber                                     String            @unique
  status                                           FMIRStatus        @default(DRAFT)
  incidentDate                                     DateTime
  incidentTime                                     String?
  department                                       String?
  rawMaterialSource                                String?
  productName                                      String?
  productItemNumber                                String?
  productCodeBatchLot                              String?
  amount                                           String?
  individualsInvolved                              String?
  foreignMaterialDescription                       String
  foreignMaterialSize                              String?
  foreignMaterialHardness                          String?
  section2Initials                                 String?
  section2Date                                     DateTime?
  isHardSharpOrLarge                               Boolean           @default(false)
  unforeseeHazardFormRequired                      Boolean           @default(false)
  causeIdentification                              String?
  possibleSource                                   String?
  howWhyOccurred                                   String?
  section3Initials                                 String?
  section3Date                                     DateTime?
  correctiveAction                                 String?
  section4Initials                                 String?
  section4Date                                     DateTime?
  verificationActions                              String?
  section5Initials                                 String?
  section5Date                                     DateTime?
  maintenanceWorkCompleted                         String?
  sanitationRequired                               Boolean           @default(false)
  sanitationNotes                                  String?
  productPlacedOnHold                              Boolean           @default(false)
  itemsHeld                                        String?
  holdDecisionDetails                              String?
  contaminationWindowDetails                       String?
  section6Initials                                 String?
  section6Date                                     DateTime?
  screeningProcess                                 String?
  section7Initials                                 String?
  section7Date                                     DateTime?
  finalDisposition                                 String?
  dispositionVolume                                String?
  dispositionJustification                         String?
  section8Initials                                 String?
  section8Date                                     DateTime?
  dispositionDate                                  DateTime?
  dispositionInitials                              String?
  preventionMeasures                               String?
  section9Initials                                 String?
  section9Date                                     DateTime?
  corporateNotified                                Boolean           @default(false)
  corporatePersonsNotified                         String?
  preShipmentReview                                String?
  preShipmentReviewDate                            DateTime?
  preShipmentSignatureRequired                     Boolean           @default(false)
  organizationId                                   String
  facilityId                                       String?
  createdById                                      String
  rcaAnalysisId                                    String?
  createdAt                                        DateTime          @default(now())
  updatedAt                                        DateTime          @updatedAt
  submittedAt                                      DateTime?
  fmSourceCategory                                 String?
  fmSourceType                                     String?
  collaboratorIds                                  String[]          @default([])
  isVisible                                        Boolean           @default(false)
  closedAt                                         DateTime?
  closedById                                       String?
  isClosed                                         Boolean           @default(false)
  area                                             String?
  line                                             String?
  submittedById                                    String?
  FMIRAIValidation                                 FMIRAIValidation?
  FMIRAuditReport                                  FMIRAuditReport[]
  FMIRComment                                      FMIRComment[]
  FMIREvidence                                     FMIREvidence[]
  User_ForeignMaterialIncident_createdByIdToUser   User              @relation("ForeignMaterialIncident_createdByIdToUser", fields: [createdById], references: [id])
  Facility                                         Facility?         @relation(fields: [facilityId], references: [id])
  Organization                                     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User_ForeignMaterialIncident_submittedByIdToUser User?             @relation("ForeignMaterialIncident_submittedByIdToUser", fields: [submittedById], references: [id])
  LinkedIncident                                   Incident?         @relation("IncidentToFMIR")

  @@index([createdById])
  @@index([facilityId])
  @@index([incidentDate])
  @@index([organizationId])
  @@index([rcaAnalysisId])
  @@index([status])
}

model Incident {
  id                                             String                   @id @default(uuid())
  incidentNumber                                 String                   @unique
  type                                           IncidentType
  categoryId                                     String
  customTitle                                    String?
  facilityId                                     String
  areaId                                         String?
  lineId                                         String?
  shiftId                                        String?
  productName                                    String?
  lotNumber                                      String?
  machineId                                      String?
  description                                    String
  aiSummary                                      String?
  occurredAt                                     DateTime
  reportedAt                                     DateTime                 @default(now())
  status                                         IncidentStatus           @default(DRAFT)
  severity                                       Severity?
  aiSuggestedSeverity                            Severity?
  createdById                                    String
  assignedToId                                   String?
  dueDate                                        DateTime?
  organizationId                                 String
  createdAt                                      DateTime                 @default(now())
  updatedAt                                      DateTime                 @updatedAt
  departmentId                                   String?
  additionalEmployerHours                        String?
  additionalEmployerStartDate                    DateTime?
  additionalEmployers                            String?
  allBodyPartsInjured                            String?
  areaSecured                                    String?
  assignmentRuleId                               String?
  autoAssigned                                   Boolean                  @default(false)
  bodyPartsAffected                              String[]
  caseClassification                             String?
  contributingActsConditions                     String?
  contributingFactors                            Json?
  dateIncidentReported                           DateTime?
  dateInjuryKnownWorkRelated                     DateTime?
  dateOfInjury                                   DateTime?
  dateTimeLeftWork                               DateTime?
  dateTimeReturnedToWork                         DateTime?
  didLeaveWork                                   Boolean?
  didReturnToWork                                Boolean?
  didSiteRevealCause                             Boolean?
  directCause                                    String?
  employedElsewhere                              Boolean?
  employeeIdNumber                               String?
  employeeName                                   String?
  environmentalConditions                        String[]
  escalatedAt                                    DateTime?
  escalatedToId                                  String?
  exposureDuration                               String?
  firstAidProvided                               Boolean?
  hadPhysicalRestrictions                        Boolean?
  incidentDate                                   DateTime?
  incidentDescriptionDetailed                    String?
  incidentTime                                   String?
  inconsistencyExplanation                       String?
  injuryCausedByWork                             String?
  injuryDescriptionDetailed                      String?
  injuryDevelopedOverTime                        Boolean?
  injuryDevelopmentPattern                       String?
  injuryLocation                                 String?
  injuryType                                     String?
  injuryTypeDescription                          String?
  injuryWitnessed                                Boolean?
  injuryWorkRelation                             String?
  interviewedNames                               String?
  investigationBodyParts                         String[]
  investigationInjuryType                        String?
  investigationSubmittedAt                       DateTime?
  investigationSubmittedById                     String?
  isAreaUnderSurveillance                        Boolean?
  isOshaRecordable                               Boolean?
  isRoutineTask                                  Boolean?
  knownRestrictions                              String?
  leaderActsConditionsOpinion                    String?
  lotoRequired                                   String?
  machineSafeguardsInPlace                       String?
  medicalProvidersInvolved                       String?
  medicalTreatmentRequired                       Boolean?
  notifiedIndividuals                            String?
  otherBodyPartDetail                            String?
  otherDutiesExplanation                         String?
  otherEmployerNames                             String?
  positionAtTimeOfIncident                       String?
  ppeRequired                                    Boolean?
  ppeWorn                                        Boolean?
  preventionRecommendations                      String?
  previousSimilarConditionDetails                String?
  previousSimilarConditionReported               Boolean?
  previousSimilarIncidents                       Boolean?
  priorSurgeryDescription                        String?
  priorSurgeryPerformed                          Boolean?
  reportedToMedicalDept                          Boolean?
  resolvedAt                                     DateTime?
  respondedAt                                    DateTime?
  siteRevealExplanation                          String?
  siteViewDate                                   DateTime?
  siteViewTime                                   String?
  slaResolutionBreached                          Boolean                  @default(false)
  slaResolutionDeadline                          DateTime?
  slaResponseBreached                            Boolean                  @default(false)
  slaResponseDeadline                            DateTime?
  sopAvailable                                   Boolean?
  sopFollowed                                    Boolean?
  specificInjuryLocation                         String?
  supervisorActions                              String?
  supervisorNotified                             Boolean?
  taskBeingPerformed                             String?
  taskFrequency                                  String?
  timeOfInjury                                   String?
  treatingDoctors                                String?
  unsafeActOrCondition                           String?
  wasClockedIn                                   Boolean?
  wasIncidentSiteViewed                          Boolean?
  wasInjuryConsistentWithSite                    Boolean?
  wasInjuryWitnessed                             Boolean?
  wasPerformingOtherDuties                       Boolean?
  wasSurveillanceAvailable                       Boolean?
  weightOrForce                                  String?
  weightOrForceUnit                              String?
  wereCoworkersPresent                           Boolean?
  wereInterviewsDocumented                       Boolean?
  werePhotosVideosTaken                          Boolean?
  witnessNames                                   String?
  witnessNamesList                               String?
  workedForOtherLast6Months                      Boolean?
  environmentalConditionsNA                      Boolean?
  bodyPartsAffectedNA                            Boolean?
  departmentWhereInjury                          String?
  employeeEmail                                  String?
  employeeGender                                 String?
  employeeHomeAddress                            String?
  employeeLanguage                               String?
  employeeLastSSN4                               String?
  employeePhone                                  String?
  interpreterAssisting                           Boolean?
  isLostTime                                     Boolean?
  jobAssignmentAtInjury                          String?
  needsInterpreter                               Boolean?
  oshaCaseNumber                                 String?
  ownedJobTitle                                  String?
  wasEmployeeInstructedInSOP                     Boolean?
  wasProperProcedureFollowed                     Boolean?
  wasViolationOfSafetyRules                      Boolean?
  isTeamIncident                                 Boolean                  @default(false)
  visibility                                     IncidentVisibility       @default(PRIVATE)
  contributingFactorTypes                        String[]
  correctiveActionTypes                          String[]
  incidentPattern                                String?
  injuryDevelopmentType                          String?
  taskRoutineType                                String?
  aiAnalysisData                                 Json?
  sharedWithUserIds                              String[]
  isPublic                                       Boolean                  @default(false)
  fmirReportId                                   String?                  @unique
  AIFishboneSession                              AIFishboneSession[]
  ArchivedChatMessage                            ArchivedChatMessage[]
  ChatMessage                                    ChatMessage[]
  Comment                                        Comment[]
  DiscussionMarker                               DiscussionMarker[]
  Evidence                                       Evidence[]
  EvidenceSpotlight                              EvidenceSpotlight[]
  MeetingRecording                               MeetingRecording[]
  Area                                           Area?                    @relation(fields: [areaId], references: [id])
  User_Incident_assignedToIdToUser               User?                    @relation("Incident_assignedToIdToUser", fields: [assignedToId], references: [id])
  Category                                       Category                 @relation(fields: [categoryId], references: [id])
  User_Incident_createdByIdToUser                User                     @relation("Incident_createdByIdToUser", fields: [createdById], references: [id])
  Department                                     Department?              @relation(fields: [departmentId], references: [id])
  Facility                                       Facility                 @relation(fields: [facilityId], references: [id])
  FMIRReport                                     ForeignMaterialIncident? @relation("IncidentToFMIR", fields: [fmirReportId], references: [id])
  User_Incident_investigationSubmittedByIdToUser User?                    @relation("Incident_investigationSubmittedByIdToUser", fields: [investigationSubmittedById], references: [id])
