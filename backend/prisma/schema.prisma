model WSAItem {
  id                   String     @id
  sectionId            String
  itemId               String
  description          String
  status               String?
  deficiency           String?
  correctiveAction     String?
  dynamicEntries       Json?
  workOrderPlaced      Boolean?   @default(false)
  reportedViaSafetyApp Boolean?   @default(false)
  safetyAppReportDate  DateTime?
  workOrderDateCreated DateTime?
  workOrderAssignedTo  String?
  workOrderAttachment  Json?
  sortOrder            Int        @default(0)
  WSASection           WSASection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, itemId])
  @@index([sectionId])
}

model WSAPhoto {
  id                        String                    @id
  assessmentId              String
  itemId                    String?
  sectionId                 String?
  fileName                  String
  fileUrl                   String
  fileSize                  Int?
  mimeType                  String?
  caption                   String?
  uploadedAt                DateTime                  @default(now())
  WorkplaceSafetyAssessment WorkplaceSafetyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([itemId])
}

model WSASection {
  id                        String                    @id
  assessmentId              String
  sectionId                 String
  title                     String
  sortOrder                 Int                       @default(0)
  WSAItem                   WSAItem[]
  WorkplaceSafetyAssessment WorkplaceSafetyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, sectionId])
  @@index([assessmentId])
}

model WorkOrder {
  id                                String                    @id
  woNumber                          String                    @unique
  type                              WorkOrderType
  assessmentId                      String
  assessmentNumber                  String
  sectionId                         String?
  itemId                            String?
  itemDescription                   String?
  requestDate                       DateTime?
  expenseClass                      String?
  originator                        String?
  woType                            String?
  priority                          Int?
  description                       String?
  equipmentNo                       String?
  equipmentDescription              String?
  fullDescriptionOfIssue            String?
  department                        String?
  fileName                          String?
  fileUrl                           String?
  fileSize                          Int?
  uploadedAt                        DateTime?
  assignedTo                        String?
  assignedById                      String?
  status                            WorkOrderStatus           @default(PENDING)
  completionDate                    DateTime?
  createdById                       String
  organizationId                    String
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime
  WorkplaceSafetyAssessment         WorkplaceSafetyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  User_WorkOrder_assignedByIdToUser User?                     @relation("WorkOrder_assignedByIdToUser", fields: [assignedById], references: [id])
  User_WorkOrder_createdByIdToUser  User                      @relation("WorkOrder_createdByIdToUser", fields: [createdById], references: [id])
  Organization                      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  WorkOrderStatusHistory            WorkOrderStatusHistory[]

  @@index([assessmentId])
  @@index([assessmentNumber])
  @@index([createdById])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([woNumber])
}

model WorkOrderSettings {
  id                     String       @id
  organizationId         String       @unique
  enableInAppForm        Boolean      @default(true)
  enableTemplateDownload Boolean      @default(false)
  preferredOption        String       @default("form")
  formTitle              String       @default("Maintenance Work Order Request")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  Organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WorkOrderStatusHistory {
  id          String           @id
  workOrderId String
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  changedById String
  changedAt   DateTime         @default(now())
  notes       String?
  User        User             @relation(fields: [changedById], references: [id])
  WorkOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([changedAt])
  @@index([changedById])
  @@index([workOrderId])
}

model WorkOrderTemplate {
  id             String       @id
  organizationId String
  name           String
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  description    String?
  version        Int          @default(1)
  isActive       Boolean      @default(true)
  uploadedById   String
  uploadedAt     DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [uploadedById], references: [id])

  @@unique([organizationId, isActive])
  @@index([isActive])
  @@index([organizationId])
}

model WorkplaceSafetyAssessment {
  id                        String       @id
  assessmentNumber          String       @unique
  version                   String       @default("3/19/25")
  date                      DateTime
  department                String?
  departmentId              String?
  teamLeaderName            String
  teamLeaderSignature       String?
  employeeName              String?
  employeeSignature         String?
  operationManagerName      String?
  operationManagerSignature String?
  plantManagerName          String?
  plantManagerSignature     String?
  safetyManagerName         String?
  safetyManagerSignature    String?
  status                    WSAStatus    @default(DRAFT)
  organizationId            String
  facilityId                String?
  createdById               String
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime
  submittedAt               DateTime?
  completedAt               DateTime?
  WSAPhoto                  WSAPhoto[]
  WSASection                WSASection[]
  WorkOrder                 WorkOrder[]
  User                      User         @relation(fields: [createdById], references: [id])
  Department                Department?  @relation(fields: [departmentId], references: [id])
  Facility                  Facility?    @relation(fields: [facilityId], references: [id])
  Organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([assessmentNumber])
  @@index([createdById])
  @@index([departmentId])
  @@index([facilityId])
  @@index([organizationId])
  @@index([status])
}

model Task {
  id             String           @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus       @default(PENDING)
  priority       TaskPriority     @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  completedById  String?          // Who marked this task as completed
  completedBy    User?            @relation("TaskCompletedBy", fields: [completedById], references: [id])
  progress       Int              @default(0) // 0-100 percentage
  
  // Lock fields
  isLocked       Boolean          @default(false)
  lockedAt       DateTime?
  lockedById     String?
  lockedBy       User?            @relation("TaskLockedBy", fields: [lockedById], references: [id])
  
  // Department assignment
  departmentId   String?
  department     Department?      @relation(fields: [departmentId], references: [id])
  
  ownerId        String
  assigneeId     String?          // Legacy single assignee (kept for backwards compatibility)
  organizationId String
  facilityId     String?
  meetingId      String?
  sourceText     String?          // Original text from transcript (if AI extracted)
  isAiExtracted  Boolean          @default(false) // Whether this was AI extracted
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignees      TaskAssignee[]   // Multiple assignees
  facility       Facility?        @relation(fields: [facilityId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User             @relation("TaskOwner", fields: [ownerId], references: [id])
  meeting        Meeting?         @relation(fields: [meetingId], references: [id])
  comments       TaskComment[]
  evidence       TaskEvidence[]
  activityLogs   TaskActivityLog[]

  @@index([ownerId])
  @@index([assigneeId])
  @@index([organizationId])
  @@index([status])
  @@index([meetingId])
  @@index([completedById])
  @@index([lockedById])
  @@index([departmentId])
}

// Task Assignees - junction table for multiple assignees
model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String?  // Who assigned this user
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation("TaskAssignees", fields: [userId], references: [id])
  assigner   User?    @relation("TaskAssigner", fields: [assignedBy], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

// Task Comments - for discussions and notes
model TaskComment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  authorId  String
  parentId  String?  // For threaded replies
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  parent    TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   TaskComment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([authorId])
}

// Task Evidence - for work done evidence/attachments
model TaskEvidence {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String?
  fileType    String?  // image, pdf, link, etc.
  fileName    String?
  taskId      String
  uploaderId  String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id])

  @@index([taskId])
  @@index([uploaderId])
}

// Task Activity Log - tracks all changes made to action items
model TaskActivityLog {
  id            String   @id @default(uuid())
  taskId        String
  userId        String   // User who made the change
  action        String   // Type of change: CREATE, UPDATE_STATUS, UPDATE_PRIORITY, UPDATE_PROGRESS, UPDATE_TITLE, UPDATE_DESCRIPTION, UPDATE_DUE_DATE, ADD_ASSIGNEE, REMOVE_ASSIGNEE, ADD_COMMENT, DELETE_COMMENT, ADD_EVIDENCE, DELETE_EVIDENCE
  field         String?  // Field that was changed (e.g., "status", "priority", "title")
  previousValue String?  // Value before the change
  newValue      String?  // Value after the change
  metadata      Json?    // Additional info (e.g., file name for evidence, assignee name)
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User     @relation("TaskActivityLogUser", fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

