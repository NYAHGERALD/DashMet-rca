# Backend Environment Variables for Render.com Production
# Copy these to your Render service environment variables

NODE_ENV=production
PORT=5002

# Database - Use Render's internal connection string
DATABASE_URL=postgresql://rca_engine_user:YOUR_PASSWORD@YOUR_RENDER_DB_HOST/rca_engine

# JWT Configuration - Generate strong secrets for production!
JWT_SECRET=generate-a-strong-random-string-min-32-chars
JWT_REFRESH_SECRET=generate-another-strong-random-string-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
# Session policy (milliseconds)
SESSION_IDLE_TIMEOUT_MS=3600000
SYSTEM_ADMIN_IDLE_TIMEOUT_MS=900000
SESSION_ABSOLUTE_TIMEOUT_MS=86400000
SYSTEM_ADMIN_ABSOLUTE_TIMEOUT_MS=43200000
# Required when frontend and API are separate Render hostnames.
SESSION_COOKIE_SAME_SITE=None

# Security
BCRYPT_ROUNDS=12
# Global API rate limit (tuned for SPA + enterprise traffic)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1200
# Login/refresh limiter tuning for enterprise networks (shared IPs)
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=200
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=120
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
SYSTEM_ADMIN_EMAIL_ALLOWLIST=security-admin@yourcompany.com
SYSTEM_ADMIN_EMAIL_ALLOWLIST_ENFORCE=true
SYSTEM_ADMIN_LOCKOUT_THRESHOLD=5
SYSTEM_ADMIN_LOCKOUT_DURATION_MINUTES=15
SYSTEM_ADMIN_LOCKOUT_ESCALATION_THRESHOLD=10
SYSTEM_ADMIN_LOCKOUT_ESCALATION_DURATION_MINUTES=60
SYSTEM_ADMIN_RATE_LIMIT_WINDOW_MINUTES=15
SYSTEM_ADMIN_IP_FAILURE_LIMIT=20
SYSTEM_ADMIN_EMAIL_FAILURE_LIMIT=8
SYSTEM_ADMIN_MFA_CHALLENGE_WINDOW_MINUTES=15
SYSTEM_ADMIN_MFA_CHALLENGE_MAX=3
SYSTEM_ADMIN_MFA_MODE=totp_or_email
SYSTEM_ADMIN_TOTP_ISSUER=DASHMET Control Center
SYSTEM_ADMIN_TOTP_WINDOW=1
# ORG_LOGIN_MFA_SCOPE options: off | admin_only | all_users
ORG_LOGIN_MFA_SCOPE=all_users
ORG_LOGIN_MFA_CODE_TTL_MS=600000
ORG_LOGIN_MFA_CHALLENGE_WINDOW_MINUTES=15
ORG_LOGIN_MFA_CHALLENGE_MAX=3
ORG_LOGIN_MFA_MAX_ATTEMPTS=5

# CORS - Update with your actual frontend URL after deployment
CORS_ORIGIN=https://dashmet-web.onrender.com
FRONTEND_URL=https://dashmet-web.onrender.com

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Firebase Admin SDK - Paste the entire JSON content as a single line
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Optional email branding fallback (used if no branding logo has been saved yet)
EMAIL_FROM=DashMet <noreply@dashmet.com>
EMAIL_LOGO_URL=
